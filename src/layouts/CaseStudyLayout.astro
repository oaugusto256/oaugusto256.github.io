---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { localePath, useT, type Locale } from '../i18n/utils';
import { slugOf, type WorkEntry } from '../content/work';

interface Props {
  locale: Locale;
  entry: WorkEntry;
  alternate?: string;
}

const { locale, entry, alternate } = Astro.props;
const { title, summary, role, period, stack, links, cover, coverAlt } = entry.data;
const t = useT(locale);
const slug = slugOf(entry);
// SVG covers are vector: no responsive widths to generate.
const coverSizing = cover.format === 'svg' ? {} : { widths: [640, 960, 1280, 1600], sizes: '(min-width: 1240px) 1240px, 100vw' };
---

<BaseLayout locale={locale} title={`${title} — ${t.work.caseStudy} · Otavio Silva`} description={summary} alternate={alternate} ogType="article">
  <article class="case" data-case-study={slug} data-locale={locale}>
    <header class="case-head on-dark">
      <div class="container head-grid">
        <div class="intro">
          <a class="back mono" href={localePath(locale, '/work/')}>{t.work.back}</a>
          <h1>{title}</h1>
          <p class="summary">{summary}</p>
        </div>
        <dl class="facts mono">
          <div><dt>{t.work.role}</dt><dd>{role}</dd></div>
          <div><dt>{t.work.period}</dt><dd>{period}</dd></div>
          <div><dt>{t.work.stack}</dt><dd>{stack.join(', ')}</dd></div>
          {
            links.length > 0 && (
              <div>
                <dt>{t.work.links}</dt>
                <dd>
                  {links.map((l) => (
                    <a href={l.url}>
                      {l.label}
                      <Icon name="arrow-up-right" size={14} />
                    </a>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </header>
    <div class="container">
      <Image class="cover" src={cover} alt={coverAlt} {...coverSizing} loading="eager" />
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .case-head {
    padding-block: var(--space-12) var(--space-16);
  }
  .head-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--space-10);
    align-items: end;
  }
  .back {
    display: inline-block;
    margin-bottom: var(--space-6);
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
  }
  h1 {
    margin-bottom: var(--space-4);
  }
  .summary {
    font-size: var(--step-1);
    color: var(--color-muted-dark);
    max-width: 36em;
  }
  .facts {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .facts div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-4);
    border-top: 1px solid var(--color-line-dark);
    padding-top: var(--space-3);
  }
  .facts dt {
    color: var(--color-muted-dark);
  }
  .facts dd {
    margin: 0;
    color: var(--color-on-dark);
  }
  .facts a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  .cover {
    width: 100%;
    height: auto;
    margin-top: calc(-1 * var(--space-8));
    border-radius: var(--radius-media);
    border: 1px solid var(--color-border);
  }
  .prose {
    max-width: 44rem;
    margin-block: var(--space-16);
  }
  .prose :global(h2) {
    font-size: var(--step-3);
    margin: var(--space-16) 0 var(--space-4);
  }
  .prose :global(h3) {
    margin: var(--space-8) 0 var(--space-3);
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-4);
  }
  .prose :global(li + li) {
    margin-top: var(--space-2);
  }
  .prose :global(figure) {
    margin: var(--space-10) 0;
  }
  .prose :global(figure img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-media);
    border: 1px solid var(--color-border);
  }
  .prose :global(figure.shots) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .prose :global(figure.shots figcaption) {
    grid-column: 1 / -1;
  }
  .prose :global(figcaption) {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    color: var(--color-muted);
  }
  @media (max-width: 47.99rem) {
    .head-grid {
      grid-template-columns: 1fr;
    }
    .facts div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
