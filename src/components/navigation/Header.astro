---
import { localePath, useT, type Locale } from '../../i18n/utils';
import { person, resumePath } from '../../data/site';
import Icon from '../ui/Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNav from './MobileNav.astro';

interface Props {
  locale: Locale;
  alternate?: string;
}

const { locale, alternate } = Astro.props;
const t = useT(locale);
const home = localePath(locale, '/');
---

<header class="site-header on-dark">
  <div class="container header-inner">
    <a class="brand" href={home}>{person.name}</a>
    <MobileNav controls="site-nav" openLabel={t.nav.open} closeLabel={t.nav.close} />
    <nav id="site-nav" class="site-nav" aria-label={t.nav.label} data-open="false">
      <ul>
        <li><a href={localePath(locale, '/work/')}>{t.nav.work}</a></li>
        <li><a href={localePath(locale, '/about/')}>{t.nav.about}</a></li>
        <li><a href={localePath(locale, '/contact/')}>{t.nav.contact}</a></li>
        <li>
          <a href={resumePath(locale)} data-event="resume_download" data-locale={locale}>
            <Icon name="file-text" size={16} />{t.nav.resume}
          </a>
        </li>
        <li>
          <a href={person.github} data-event="contact_click" data-channel="github" aria-label="GitHub">
            <Icon name="github" size={18} /><span class="nav-text">GitHub</span>
          </a>
        </li>
        <li>
          <a href={person.linkedin} data-event="contact_click" data-channel="linkedin" aria-label="LinkedIn">
            <Icon name="linkedin" size={18} /><span class="nav-text">LinkedIn</span>
          </a>
        </li>
        <li><LanguageSwitcher locale={locale} alternate={alternate} /></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-line-dark);
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    min-height: 4rem;
  }
  .brand {
    font-weight: 600;
    text-decoration: none;
    color: inherit;
  }
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    color: inherit;
    text-decoration: none;
  }
  .site-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .nav-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Small screens with JS: collapse behind the toggle. Without JS the list stays visible. */
  @media (max-width: 47.99rem) {
    :global(html.js) .site-nav {
      flex-basis: 100%;
    }
    :global(html.js) .site-nav[data-open='false'] {
      display: none;
    }
    :global(html.js) .site-nav ul {
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: 1rem;
    }
    :global(html.js) .nav-text {
      position: static;
      width: auto;
      height: auto;
      clip: auto;
    }
  }
</style>
